# Copy to project root: cp deploy/.env.example .env
# Create DB: /home/ubuntu/infra/scripts/create-app-db.sh npinc

NODE_ENV=production
PORT=8080

SESSION_SECRET=change-me-session-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_RESET_PHRASE=change-me-secret-phrase

# Docker apps on infra_shared use host postgres:5432
DATABASE_URL=postgresql://npinc_app:change-me@postgres:5432/npinc

# For host-side db push / seed (127.0.0.1)
# DATABASE_URL=postgresql://npinc_app:change-me@127.0.0.1:5432/npinc
